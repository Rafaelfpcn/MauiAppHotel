<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             Title="HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Secondary}">

    <ScrollView>
        <VerticalStackLayout VerticalOptions="CenterAndExpand"
                             Padding="15"
                             Spacing="10">

            <Label Text="Resumo da Reserva"
                   FontSize="Subtitle"
                   TextColor="{StaticResource Tertiary}" />

            <Label Text="{Binding QuartoSelecionado.Descricao}"
                   FontFamily="Kalam"
                   FontSize="40"
                   TextColor="{StaticResource Primary}" />

            <Frame Padding="10" CornerRadius="15" BorderColor="{StaticResource Tertiary}">
                <Grid ColumnDefinitions="*, *">
                    <HorizontalStackLayout Grid.Column="0" HorizontalOptions="Center">
                        <Label Text="Adultos: " />
                        <Label Text="{Binding QntAdultos}"
                               TextColor="{StaticResource Primary}" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout Grid.Column="1" HorizontalOptions="Center">
                        <Label Text="Crianças: " />
                        <Label Text="{Binding QntCriancas}"
                               TextColor="{StaticResource Primary}" />
                    </HorizontalStackLayout>
                </Grid>
            </Frame>

            <Frame Padding="10" CornerRadius="15" BorderColor="{StaticResource Tertiary}">
                <Grid ColumnDefinitions="*, *, *"
                      RowDefinitions="Auto, Auto">
                    <Label Grid.Row="0" Grid.Column="0" Text="Check-in:" />
                    <Label Grid.Row="0" Grid.Column="1" Text="Check-out:" />
                    <Label Grid.Row="0" Grid.Column="2" Text="Diárias:" />

                    <Label Grid.Row="1" Grid.Column="0"
                           Text="{Binding DataCheckIn, StringFormat='{}{0:dd/MM/yyyy}'}"
                           TextColor="{StaticResource Primary}" />

                    <Label Grid.Row="1" Grid.Column="1"
                           Text="{Binding DataCheckOut, StringFormat='{}{0:dd/MM/yyyy}'}"
                           TextColor="{StaticResource Primary}" />

                    <Label Grid.Row="1" Grid.Column="2"
                           Text="{Binding Estadia}"
                           TextColor="{StaticResource Primary}" />
                </Grid>
            </Frame>

            <Frame Padding="15" CornerRadius="15" BackgroundColor="{StaticResource Primary}">
                <VerticalStackLayout>
                    <Label Text="VALOR TOTAL"
                           FontSize="Small"
                           TextColor="{StaticResource Tertiary}" />
                    <Label Text="{Binding ValorTotal, StringFormat='{}{0:C}'}"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="{StaticResource White}" />
                </VerticalStackLayout>
            </Frame>

            <Button Text="Voltar"
                    CornerRadius="10"
                    BackgroundColor="{StaticResource Tertiary}"
                    Clicked="btn_voltar_Clicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
